# Environment Variables for Docker Compose Deployment
PORT=3000
NODE_ENV=production
MONGODB_URI=mongodb://mongo:27017/diarydb
ACCESS_TOKEN_SECRET=replace_with_a_secure_random_string_in_production
REFRESH_TOKEN_SECRET=replace_with_another_secure_random_string_in_production
CLIENT_URL=http://your-ec2-public-ip-or-domain
SERVER_URL=http://your-ec2-public-ip-or-domain
