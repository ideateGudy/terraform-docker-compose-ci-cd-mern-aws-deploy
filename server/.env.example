# Database Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/todo

# JWT Security Secrets
ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-refresh-secret

# Frontend Client URL (used for CORS origin validation)
# Local: http://localhost:5173 | Production: https://ideategudy.tech
CLIENT_URL=http://localhost:5173

# Server URL (used as base URL for generating short URLs e.g. ${SERVER_URL}/s/abc1234)
# Local: http://localhost:3000 | Production: https://ideategudy.tech
SERVER_URL=http://localhost:3000

# Port for local Express server
PORT=3000